import asyncio
import websockets
import json
import os
import requests
from shared_hub import hub   # 🆕 추가: DataHub 연동

# 설정
TIMEFRAMES = ['1H', '4H', '1D']
SYMBOL = "BTC-USDT"

# ----------------------------------------------------
# [해결 3] 파일 읽기/쓰기 충돌(Race Condition) 방지 함수
# ----------------------------------------------------
def atomic_save_json(filename, data):
    tmp_filename = f"{filename}.tmp"
    with open(tmp_filename, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp_filename, filename)

# ----------------------------------------------------
# [해결 2] 문자열 -> 숫자(float) 형변환 함수
# ----------------------------------------------------
def format_candle_data(raw_candle):
    return [
        raw_candle[0],          # ts (타임스탬프)
        float(raw_candle[1]),   # open (시가)
        float(raw_candle[2]),   # high (고가)
        float(raw_candle[3]),   # low (저가)
        float(raw_candle[4]),   # close (종가)
        float(raw_candle[5]),   # vol (거래량)
        raw_candle[6],          # volCcy
        raw_candle[7],          # volCcyQuote
        raw_candle[8]           # confirm (봉 마감 여부: '0' 또는 '1')
    ]

# ----------------------------------------------------
# [해결 4] 초기 500개 데이터 확보 및 과거 순 정렬 (Bootstrapping)
# ----------------------------------------------------
def fetch_initial_history(tf):
    """웹소켓 시작 전, 과거 캔들 500개를 REST API로 1회 먼저 가져와 정렬하는 함수"""
    url = f"https://www.okx.com/api/v5/market/candles?instId={SYMBOL}&bar={tf}&limit=500"
    try:
        r = requests.get(url, timeout=5)
        raw_data = r.json().get('data', [])
        if not raw_data:
            return []
        
        # 1. 수집과 동시에 숫자형으로 변환 (해결 2)
        formatted_data = [format_candle_data(c) for c in raw_data]
        
        # 2. OKX의 [최신->과거] 순서를 매물대 로직이 원하는 [과거->최신] 순서로 뒤집기 (해결 4)
        formatted_data.reverse()
        return formatted_data
    except Exception as e:
        print(f"⚠️ {tf} 초기 히스토리 로드 실패: {e}")
        return []

# ----------------------------------------------------
# [추가] skill.py의 요청을 받아 데이터를 전달해 주는 배달부 함수
# ----------------------------------------------------
def get_live_candles_with_volume(tf='1h'):
    """
    skill.py의 요청을 받아서 
    1) 현재가 파일과 
    2) 해당 타임프레임(1h, 4h, 1d)의 캔들(거래량 포함) 데이터를 읽어와서 반환합니다.
    """
    if not os.path.exists("live_price.json"):
        print("⚠️ 실시간 현재가 파일(live_price.json)을 찾을 수 없습니다.")
        return None, 0.0
        
    with open("live_price.json", "r") as f:
        price_data = json.load(f)
        current_price = float(price_data["price"])

    candle_file = f"{tf.lower()}.json"
    if not os.path.exists(candle_file):
        print(f"⚠️ 실시간 캔들 파일({candle_file})을 찾을 수 없습니다.")
        return None, 0.0
        
    with open(candle_file, "r") as f:
        raw_candles = json.load(f)
        
    cols = ['timestamp', 'open', 'high', 'low', 'close', 'volume', 'volCcy', 'volCcyQuote', 'confirm']
    import pandas as pd
    df = pd.DataFrame(raw_candles, columns=cols)
    
    for col in ['open', 'high', 'low', 'close', 'volume']:
        df[col] = pd.to_numeric(df[col], errors='coerce')

    return df, current_price

# ----------------------------------------------------
# [해결 1] 0.1초 무한 호출을 막는 웹소켓 엔진
# ----------------------------------------------------
async def watch_live_market():
    # 타임프레임별 500개 캔들 메모리 버퍼 초기화
    candle_buffers = {}
    for tf in TIMEFRAMES:
        print(f"📦 {tf} 초기 데이터 500개 다운로드 중...")
        candle_buffers[tf] = fetch_initial_history(tf)
        if candle_buffers[tf]:
            atomic_save_json(f"{tf.lower()}.json", candle_buffers[tf])
            hub.update(tf.lower(), candle_buffers[tf])  # 🆕 추가: 초기 500개 hub에 반영
    
    uri = "wss://ws.okx.com:443/ws/v5/public"
    
    while True:
        try:
            print(f"\n📡 OKX 실시간 웹소켓 서버 연결 시도... ({SYMBOL})")
            async with websockets.connect(uri, ping_interval=20, ping_timeout=20) as websocket:
                print("✅ OKX 웹소켓 연결 성공! 데이터 실시간 구독을 시작합니다.")
                
                # 구독 채널 세팅 (실시간 시장가 + 1H/4H/1D 캔들)
                subscribe_msg = {
                    "op": "subscribe",
                    "args": [
                        {"channel": "tickers", "instId": SYMBOL},
                        {"channel": f"candle{TIMEFRAMES[0]}", "instId": SYMBOL},
                        {"channel": f"candle{TIMEFRAMES[1]}", "instId": SYMBOL},
                        {"channel": f"candle{TIMEFRAMES[2]}", "instId": SYMBOL}
                    ]
                }
                await websocket.send(json.dumps(subscribe_msg))
                
                # OKX가 던져주는 데이터를 실시간으로 수신 (0.1초마다 requests 날릴 필요 없음)
                async for message in websocket:
                    packet = json.loads(message)
                    
                    if "data" not in packet:
                        continue
                        
                    channel = packet["arg"]["channel"]
                    raw_data = packet["data"][0]
                    
                    # 1. 실시간 시장가 틱 처리 (live_price.json)
                    if channel == "tickers":
                        # 문자열 가격을 숫자로 즉시 캐스팅 (해결 2)
                        last_price = float(raw_data["last"])
                        
                        # 파일 충돌 없이 안전하게 저장 (해결 3)
                        atomic_save_json("live_price.json", {"price": last_price})
                        hub.update("live_price", last_price)  # 🆕 추가: 실시간가 hub에 반영
                    
                    # 2. 실시간 캔들 업데이트 처리 (1h.json, 4h.json, 1d.json)
                    elif "candle" in channel:
                        # 채널명에서 타임프레임 추출 (예: candle1H -> 1H)
                        tf_key = channel.replace("candle", "")
                        
                        new_candle = format_candle_data(raw_data)
                        buffer = candle_buffers.get(tf_key, [])
                        
                        if buffer:
                            # 현재 수신한 실시간 캔들이 버퍼의 맨 마지막(최신) 캔들과 같은 시간대라면 -> 갱신
                            if buffer[-1][0] == new_candle[0]:
                                buffer[-1] = new_candle
                            # 새로운 시간대의 캔들이 시작되었다면 -> 추가 후 500개 유지
                            else:
                                buffer.append(new_candle)
                                if len(buffer) > 500:
                                    buffer.pop(0) # 맨 앞(가장 과거) 캔들 제거
                            
                            # 파일 덮어쓰기 충돌 차단 (해결 3)
                            atomic_save_json(f"{tf_key.lower()}.json", buffer)
                            hub.update(tf_key.lower(), buffer)  # 🆕 추가: hub에도 동일하게 반영
                            
        except (websockets.exceptions.ConnectionClosed, Exception) as e:
            print(f"⚠️ 연결이 끊겼거나 에러가 발생했습니다: {e}")
            print("🔄 5초 후 안전하게 재연결을 시도합니다...")
            await asyncio.sleep(5)

if __name__ == "__main__":
    try:
        asyncio.run(watch_live_market())
    except KeyboardInterrupt:
        print("\n👋 수집기가 사용자에 의해 안전하게 종료되었습니다.")
