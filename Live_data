# ----------------------------------------------------
# 이름 생성 함수 - 코인/타임프레임/항목 이름을 손으로 안 치고 통일해서 생성
# ----------------------------------------------------
def make_key(symbol, timeframe, field):
    parts = [symbol.lower()]
    if timeframe:
        parts.append(timeframe.lower())
    parts.append(field)
    return "_".join(parts)


def swap_inst_id(symbol):
    """미체결약정/펀딩비율은 무기한 스왑(선물) 전용이라 현물 심볼을 스왑 심볼로 변환.
    예: BTC-USDT -> BTC-USDT-SWAP
    실제로 스왑 거래를 안 한다면 이 두 지표는 값이 안 들어올 수 있음."""
    return f"{symbol}-SWAP"


# ----------------------------------------------------
# [활성 코인] 지금 실제로 매매 중인 코인 하나를 관리
# 포지션 청산 후 코인을 바꿀 때 set_active_symbol()을 호출하면 됨.
# 데이터 수집(SYMBOLS 전체)과는 별개 - 데이터는 항상 다 받고 있고, 이건 그중 "지금 매매 대상"만 표시.
# ----------------------------------------------------
def get_active_symbol():
    if os.path.exists(ACTIVE_SYMBOL_FILE):
        try:
            with open(ACTIVE_SYMBOL_FILE) as f:
                return json.load(f)["symbol"]
        except Exception:
            pass
    return SYMBOLS[0]


def set_active_symbol(symbol):
    if symbol not in SYMBOLS:
        raise ValueError(f"{symbol}은 SYMBOLS 목록에 없음 - 먼저 SYMBOLS에 추가해야 함")
    atomic_save_json(ACTIVE_SYMBOL_FILE, {"symbol": symbol})
    hub.update("active_symbol", symbol)  # shared_hub.py에 읽는 방법이 따로 있다면 그쪽으로 바꿔도 됨


def atomic_save_json(filename, data):
    tmp_filename = f"{filename}.tmp"
    with open(tmp_filename, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp_filename, filename)


def format_candle_data(raw_candle):
    return [
        raw_candle[0],           # ts
        float(raw_candle[1]),    # open
        float(raw_candle[2]),    # high
        float(raw_candle[3]),    # low
        float(raw_candle[4]),    # close
        float(raw_candle[5]),    # vol
        float(raw_candle[6]),    # volCcy - 숫자로 변환됨
        float(raw_candle[7]),    # volCcyQuote - 숫자로 변환됨
        raw_candle[8] == '1',    # confirm - 진짜 True/False
    ]


def fetch_initial_history(symbol, tf):
    url = f"https://www.okx.com/api/v5/market/candles?instId={symbol}&bar={tf}&limit=500"
    try:
        r = requests.get(url, timeout=5)
        raw_data = r.json().get('data', [])
        if not raw_data:
            return []
        formatted_data = [format_candle_data(c) for c in raw_data]
        formatted_data.reverse()
        return formatted_data
    except Exception as e:
        logger.warning(f"{symbol} {tf} 초기 히스토리 로드 실패: {e}")
        return []


def fetch_long_short_ratio(symbol):
    """OKX는 롱숏비율을 웹소켓으로 push 안 함 (REST 전용). 주기적으로 직접 요청.
    아래 엔드포인트는 OKX v5 REST 관례를 따른 것 - 실제 사용 전 공식 문서로 한 번 더
    확인 권장 (검색으로 채널 존재는 확인했지만 정확한 경로까지는 재확인 필요)."""
    url = "https://www.okx.com/api/v5/rubik/stat/contracts/long-short-account-ratio-contract"
    try:
        r = requests.get(url, params={"instId": swap_inst_id(symbol), "period": "5m"}, timeout=5)
        data = r.json().get("data", [])
        if data:
            return float(data[0][1])
    except Exception as e:
        logger.warning(f"{symbol} 롱숏비율 조회 실패: {e}")
    return None


# =========================================================================
# 🆕 매매기법 파일(skill.py 등)이 공통으로 쓰는 데이터 접근 API
# 심볼+타임프레임+지표이름만 넣으면 해당 데이터만 쏙 꺼내옴.
# 전부 재시도 안전 읽기(수집기가 쓰는 도중 읽어도 안 깨짐)가 내장돼 있음.
# =========================================================================
def _load_json_with_retry(path, retries=3, delay=0.05):
    """수집기가 파일을 쓰는 도중과 읽는 시점이 겹치면 JSON이 일시적으로 깨져 보일 수 있어서,
    아주 짧게 텀을 두고 몇 번 재시도한 뒤에도 실패하면 (None, 에러메시지)를 돌려줌."""
    last_err = None
    for attempt in range(retries):
        try:
            with open(path, "r") as f:
                return json.load(f), None
        except (json.JSONDecodeError, OSError) as e:
            last_err = e
            if attempt < retries - 1:
                time.sleep(delay)
    return None, str(last_err)


def get_price(symbol=None, max_staleness_sec=None):
    """실시간 현재가를 가져옴 (float). symbol 생략 시 활성 코인 사용.
    max_staleness_sec을 주면, 저장된 ts가 그보다 오래됐을 때 경고만 띄움(값은 그대로 반환)."""
    if symbol is None:
        symbol = get_active_symbol()
    path = f"{make_key(symbol, None, 'live_price')}.json"
    if not os.path.exists(path):
        logger.warning(f"실시간 현재가 파일({path})을 찾을 수 없습니다.")
        return None
    data, err = _load_json_with_retry(path)
    if data is None:
        logger.warning(f"실시간 현재가 파일({path}) 파싱 실패: {err}")
        return None
    if max_staleness_sec is not None and data.get("ts") is not None:
        try:
            age = time.time() - (float(data["ts"]) / 1000)
            if age > max_staleness_sec:
                logger.warning(f"[{symbol}] 가격 데이터가 {age:.0f}초 전 것으로 보입니다 "
                                f"(허용치 {max_staleness_sec}초) — 수집기가 멈췄을 수 있습니다.")
        except (TypeError, ValueError):
            pass
    return float(data["price"])


def get_candles(symbol=None, tf='1H'):
    """캔들(OHLCV) 데이터를 DataFrame으로 가져옴. symbol 생략 시 활성 코인 사용.
    tf는 대소문자 상관없음 (make_key가 내부적으로 통일함)."""
    import pandas as pd
    if symbol is None:
        symbol = get_active_symbol()
    path = f"{make_key(symbol, tf, 'candles')}.json"
    if not os.path.exists(path):
        logger.warning(f"캔들 파일({path})을 찾을 수 없습니다.")
        return None
    raw_candles, err = _load_json_with_retry(path)
    if raw_candles is None:
        logger.warning(f"캔들 파일({path}) 파싱 실패: {err}")
        return None
    cols = ['timestamp', 'open', 'high', 'low', 'close', 'volume', 'volCcy', 'volCcyQuote', 'confirm']
    if raw_candles and len(raw_candles[0]) != len(cols):
        logger.warning(f"캔들 데이터 컬럼 수가 예상과 다릅니다 (예상 {len(cols)}, 실제 {len(raw_candles[0])}) - {path}")
        return None
    df = pd.DataFrame(raw_candles, columns=cols)
    for col in ['open', 'high', 'low', 'close', 'volume', 'volCcy', 'volCcyQuote']:
        df[col] = pd.to_numeric(df[col], errors='coerce')
    return df


def get_indicator(symbol, tf, name):
    """보조지표(rsi/macd/mfi/volume_ratio/cvd) 시리즈를 가져옴.
    캔들 버퍼와 같은 인덱스로 정렬된 리스트를 그대로 반환 (예: get_indicator("BTC-USDT","1H","macd"))."""
    path = f"{make_key(symbol, tf, name)}.json"
    if not os.path.exists(path):
        logger.warning(f"지표 파일({path})을 찾을 수 없습니다.")
        return None
    data, err = _load_json_with_retry(path)
    if data is None:
        logger.warning(f"지표 파일({path}) 파싱 실패: {err}")
    return data


def get_history(symbol, field):
    """OI/펀딩비처럼 심볼 단위(타임프레임 무관) 롤링 히스토리를 가져옴.
    예: get_history("BTC-USDT", "open_interest"), get_history("BTC-USDT", "funding_rate")"""
    path = f"{make_key(symbol, None, f'{field}_history')}.json"
    if not os.path.exists(path):
        logger.warning(f"히스토리 파일({path})을 찾을 수 없습니다.")
        return None
    data, err = _load_json_with_retry(path)
    if data is None:
        logger.warning(f"히스토리 파일({path}) 파싱 실패: {err}")
    return data


def get_live_candles_with_volume(symbol=None, tf='1h'):
    """(기존 함수, 하위호환 유지) 캔들+현재가를 함께 반환 — 내부적으로 get_candles/get_price를 씀."""
    df = get_candles(symbol=symbol, tf=tf)
    price = get_price(symbol=symbol)
    if df is None or price is None:
        return None, 0.0
    return df, price





def _compute_and_save_indicators(symbol, tf, buffer):
    """🆕 캔들 버퍼로 RSI/MACD/MFI/거래량비율을 계산해서 저장.
    초기 히스토리 로드 시점(_load_all_history)과 실시간 캔들 갱신 시점 둘 다에서 호출됨 -
    그래야 수집기를 막 켰을 때도 과거 500개 구간 지표가 바로 채워져 있음."""
    if len(buffer) < 2:
        return
    closes = [row[4] for row in buffer]
    highs = [row[2] for row in buffer]
    lows = [row[3] for row in buffer]
    volumes = [row[5] for row in buffer]

    series_map = {
        "rsi": indicators.calculate_rsi(closes, period=14),
        "macd": indicators.calculate_macd(closes, fast=12, slow=26, signal=9),
        "mfi": indicators.calculate_mfi(highs, lows, closes, volumes, period=14),
        "volume_ratio": indicators.calculate_volume_ratio(volumes, lookback=20),
    }
    for field, series in series_map.items():
        key = make_key(symbol, tf, field)
        atomic_save_json(f"{key}.json", series)
        hub.update(key, series)


def _update_history_buffer(buffers, symbol, field, value, ts):
    """🆕 OI/펀딩비처럼 최신값만 hub에 덮어쓰던 데이터를, 캔들처럼 최근 MAX_HISTORY개
    롤링 히스토리로도 남김 (추세/증가여부 판단에 필요). [timestamp, value] 쌍으로 저장."""
    buf = buffers.setdefault(symbol, [])
    buf.append([ts, value])
    if len(buf) > MAX_HISTORY:
        buf.pop(0)
    key = make_key(symbol, None, f"{field}_history")
    atomic_save_json(f"{key}.json", buf)
    hub.update(key, buf)


def fetch_taker_volume(symbol, period, limit=300):
    """OKX 통계 API로 기간별 매수/매도 테이커 거래량을 가져옴 (CVD 계산용).
    캔들 API 자체엔 이 데이터가 없어서(9개 컬럼 확인됨) 별도 엔드포인트로 받아야 함.
    참고: 이 엔드포인트가 5m/1H/1D는 지원하는 게 확인됐는데 4H 지원 여부는 불확실해서
    4H는 이 함수로 직접 안 부르고 1H를 모아 합산하는 방식(_aggregate_1h_to_4h)을 씀.
    실사용 전 공식 문서로 최종 파라미터 확인 권장 (롱숏비율 엔드포인트와 동일한 주의사항)."""
    ccy = symbol.split("-")[0]
    url = "https://www.okx.com/api/v5/rubik/stat/taker-volume"
    try:
        r = requests.get(url, params={"ccy": ccy, "period": period, "instType": "CONTRACTS",
                                       "limit": str(limit)}, timeout=5)
        raw = r.json().get("data", [])
        rows = [[row[0], float(row[1]), float(row[2])] for row in raw]  # [ts, 매도량, 매수량]
        rows.sort(key=lambda x: int(x[0]))  # 반환 순서를 확신할 수 없어 오래된 순으로 방어적 정렬
        return rows
    except Exception as e:
        logger.warning(f"{symbol} {period} 테이커 거래량 조회 실패: {e}")
        return []


def _aggregate_1h_to_4h(taker_1h_rows, candle_4h_buffer):
    """1H 테이커 거래량을 실제 4H 캔들 경계에 맞춰 4개씩 합산.
    4H 캔들이 정확히 몇 시에 시작하는지 직접 계산 안 해도 되게, 이미 올바른 경계를
    가진 4H 캔들 버퍼의 타임스탬프를 기준으로 삼음."""
    if not taker_1h_rows or not candle_4h_buffer:
        return []
    lookup = {int(ts): (sell, buy) for ts, sell, buy in taker_1h_rows}
    sorted_ts = sorted(lookup.keys())
    result = []
    for candle in candle_4h_buffer:
        ts_4h = int(candle[0])
        window_end = ts_4h + 4 * 3600 * 1000
        sell_sum = buy_sum = 0.0
        found_any = False
        for ts1h in sorted_ts:
            if ts_4h <= ts1h < window_end:
                s, b = lookup[ts1h]
                sell_sum += s
                buy_sum += b
                found_any = True
            elif ts1h >= window_end:
                break
        if found_any:
            result.append([str(ts_4h), sell_sum, buy_sum])
    return result


def _compute_cvd_series(taker_rows, candle_buffer):
    """[ts, 매도량, 매수량] 시리즈로 델타 누적합(CVD)을 구해서 캔들 버퍼와 같은
    길이/순서의 리스트로 반환. 해당 캔들 시점에 매칭되는 테이커 데이터가 없으면 None."""
    if not taker_rows:
        return [None] * len(candle_buffer)
    taker_rows_sorted = sorted(taker_rows, key=lambda x: int(x[0]))
    cvd_lookup = {}
    running = 0.0
    for ts, sell, buy in taker_rows_sorted:
        running += (buy - sell)
        cvd_lookup[int(ts)] = round(running, 4)
    return [cvd_lookup.get(int(candle[0])) for candle in candle_buffer]


def _update_cvd(symbol, tf, candle_buffer):
    """CVD를 계산해서 RSI/MACD/MFI와 동일한 패턴(캔들과 같은 인덱스)으로 저장."""
    if not candle_buffer:
        return
    if tf == '4H':
        taker_1h = fetch_taker_volume(symbol, '1H', limit=max(500, len(candle_buffer) * 4))
        taker_rows = _aggregate_1h_to_4h(taker_1h, candle_buffer)
    else:
        taker_rows = fetch_taker_volume(symbol, tf, limit=max(300, len(candle_buffer)))

    cvd_series = _compute_cvd_series(taker_rows, candle_buffer)
    key = make_key(symbol, tf, "cvd")
    atomic_save_json(f"{key}.json", cvd_series)
    hub.update(key, cvd_series)



    """모든 심볼×타임프레임의 과거 500개를 불러와 반영. 재연결마다 다시 호출해서
    끊긴 구간의 빈 캔들을 메꾼다."""
    for symbol in SYMBOLS:
        for tf in TIMEFRAMES:
            history = fetch_initial_history(symbol, tf)
            if history:
                candle_buffers[(symbol, tf)] = history
                key = make_key(symbol, tf, "candles")
                atomic_save_json(f"{key}.json", history)
                hub.update(key, history)
                _compute_and_save_indicators(symbol, tf, history)
                _update_cvd(symbol, tf, history)  # 🆕


async def poll_long_short_ratio():
    """롱숏비율은 웹소켓이 없어서 별도 루프로 주기적으로 갱신."""
    while True:
        for symbol in SYMBOLS:
            ratio = fetch_long_short_ratio(symbol)
            if ratio is not None:
                hub.update(make_key(symbol, None, "long_short_ratio"), ratio)
        await asyncio.sleep(LONG_SHORT_POLL_SECONDS)


async def watch_live_market(candle_buffers):
    oi_buffers = {}
    funding_buffers = {}
    logger.info("초기 히스토리 로딩 중...")
    _load_all_history(candle_buffers)

    uri = "wss://ws.okx.com:443/ws/v5/public"

    while True:
        try:
            async with websockets.connect(uri, ping_interval=20, ping_timeout=20) as websocket:
                logger.info("OKX 웹소켓 연결 성공")
                _load_all_history(candle_buffers)  # 재연결마다 히스토리 재로딩

                args = []
                for s in SYMBOLS:
                    args.append({"channel": "tickers", "instId": s})
                    for tf in TIMEFRAMES:
                        args.append({"channel": f"candle{tf}", "instId": s})
                    swap_id = swap_inst_id(s)
                    args.append({"channel": "open-interest", "instId": swap_id})
                    args.append({"channel": "funding-rate", "instId": swap_id})
                await websocket.send(json.dumps({"op": "subscribe", "args": args}))

                async for message in websocket:
                    packet = json.loads(message)

                    if packet.get("event") == "error":
                        logger.error(f"OKX 웹소켓 에러 응답: {packet}")
                        continue
                    if "data" not in packet:
                        continue

                    arg = packet["arg"]
                    channel = arg["channel"]
                    inst_id = arg.get("instId", SYMBOLS[0])
                    symbol = inst_id.replace("-SWAP", "")  # 스왑 채널도 원래 심볼 이름으로 통일
                    raw_data = packet["data"][0]

                    if channel == "tickers":
                        last_price = float(raw_data["last"])
                        key = make_key(symbol, None, "live_price")
                        # 🆕 ts도 같이 저장 (get_price의 신선도 체크 기능이 실제로 동작하려면 필요)
                        atomic_save_json(f"{key}.json", {"price": last_price, "ts": raw_data.get("ts")})
                        hub.update(key, last_price)

                    elif channel == "open-interest":
                        oi_val = float(raw_data["oi"])
                        ts = raw_data.get("ts", str(int(time.time() * 1000)))
                        key = make_key(symbol, None, "open_interest")
                        hub.update(key, oi_val)  # 기존 "최신값만" 키는 호환을 위해 유지
                        _update_history_buffer(oi_buffers, symbol, "open_interest", oi_val, ts)  # 🆕 추세 판단용

                    elif channel == "funding-rate":
                        fr_val = float(raw_data["fundingRate"])
                        ts = raw_data.get("ts", str(int(time.time() * 1000)))
                        key = make_key(symbol, None, "funding_rate")
                        hub.update(key, fr_val)  # 기존 "최신값만" 키는 호환을 위해 유지
                        _update_history_buffer(funding_buffers, symbol, "funding_rate", fr_val, ts)  # 🆕 추세 판단용

                    elif "candle" in channel:
                        tf_key = channel.replace("candle", "")
                        new_candle = format_candle_data(raw_data)
                        buffer = candle_buffers.setdefault((symbol, tf_key), [])
                        if buffer and buffer[-1][0] == new_candle[0]:
                            buffer[-1] = new_candle
                        else:
                            buffer.append(new_candle)
                            if len(buffer) > 500:
                                buffer.pop(0)
                        key = make_key(symbol, tf_key, "candles")
                        atomic_save_json(f"{key}.json", buffer)
                        hub.update(key, buffer)
                        _compute_and_save_indicators(symbol, tf_key, buffer)  # RSI/MACD/MFI/거래량비율 갱신
                        # CVD는 REST 통계 엔드포인트라 캔들 틱마다(초당 여러 번일 수 있음) 부르면
                        # 과도하니 여기선 안 부르고, 아래 poll_cvd()가 주기적으로 갱신함

        except (websockets.exceptions.ConnectionClosed, OSError, asyncio.TimeoutError) as e:
            logger.warning(f"웹소켓 연결 문제 - 5초 후 재연결 시도: {type(e).__name__}: {e}")
            await asyncio.sleep(5)
        except Exception as e:
            logger.exception(f"예상치 못한 에러 발생 (연결 문제가 아니라 코드 버그일 수 있음): {e}")
            await asyncio.sleep(5)


async def poll_cvd(candle_buffers):
    """CVD는 웹소켓 푸시가 없는 통계 데이터라, 주기적으로 다시 계산해서 갱신.
    그 사이에 캔들이 갱신되며 candle_buffers가 채워지고 있으므로 이미 채워진 것만 갱신."""
    while True:
        for symbol in SYMBOLS:
            for tf in TIMEFRAMES:
                buffer = candle_buffers.get((symbol, tf))
                if buffer:
                    _update_cvd(symbol, tf, buffer)
        await asyncio.sleep(CVD_POLL_SECONDS)


async def main():
    candle_buffers = {}  # 🆕 watch_live_market과 poll_cvd가 공유 (CVD를 캔들 인덱스에 맞추기 위해 필요)
    await asyncio.gather(
        watch_live_market(candle_buffers),
        poll_long_short_ratio(),
        poll_cvd(candle_buffers),  # 🆕
    )


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\n👋 수집기가 사용자에 의해 안전하게 종료되었습니다.")

