import asyncio
import websockets
import json
import os
import logging
import requests
from shared_hub import hub

logger = logging.getLogger(__name__)

# ----------------------------------------------------
# 설정
# ----------------------------------------------------
TIMEFRAMES = ['1H', '4H', '1D']
SYMBOLS = ["BTC-USDT", "ETH-USDT", "XRP-USDT"]  # 코인 추가/삭제는 이 리스트만 건드리면 됨
LONG_SHORT_POLL_SECONDS = 60  # 롱숏비율은 웹소켓이 없어서 이 주기로 REST 폴링
ACTIVE_SYMBOL_FILE = "active_symbol.json"


# ----------------------------------------------------
# 이름 생성 함수 - 코인/타임프레임/항목 이름을 손으로 안 치고 통일해서 생성
# ----------------------------------------------------
def make_key(symbol, timeframe, field):
    parts = [symbol.lower()]
    if timeframe:
        parts.append(timeframe.lower())
    parts.append(field)
    return "_".join(parts)


def swap_inst_id(symbol):
    """미체결약정/펀딩비율은 무기한 스왑(선물) 전용이라 현물 심볼을 스왑 심볼로 변환.
    예: BTC-USDT -> BTC-USDT-SWAP
    실제로 스왑 거래를 안 한다면 이 두 지표는 값이 안 들어올 수 있음."""
    return f"{symbol}-SWAP"


# ----------------------------------------------------
# [활성 코인] 지금 실제로 매매 중인 코인 하나를 관리
# 포지션 청산 후 코인을 바꿀 때 set_active_symbol()을 호출하면 됨.
# 데이터 수집(SYMBOLS 전체)과는 별개 - 데이터는 항상 다 받고 있고, 이건 그중 "지금 매매 대상"만 표시.
# ----------------------------------------------------
def get_active_symbol():
    if os.path.exists(ACTIVE_SYMBOL_FILE):
        try:
            with open(ACTIVE_SYMBOL_FILE) as f:
                return json.load(f)["symbol"]
        except Exception:
            pass
    return SYMBOLS[0]


def set_active_symbol(symbol):
    if symbol not in SYMBOLS:
        raise ValueError(f"{symbol}은 SYMBOLS 목록에 없음 - 먼저 SYMBOLS에 추가해야 함")
    atomic_save_json(ACTIVE_SYMBOL_FILE, {"symbol": symbol})
    hub.update("active_symbol", symbol)  # shared_hub.py에 읽는 방법이 따로 있다면 그쪽으로 바꿔도 됨


def atomic_save_json(filename, data):
    tmp_filename = f"{filename}.tmp"
    with open(tmp_filename, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp_filename, filename)


def format_candle_data(raw_candle):
    return [
        raw_candle[0],           # ts
        float(raw_candle[1]),    # open
        float(raw_candle[2]),    # high
        float(raw_candle[3]),    # low
        float(raw_candle[4]),    # close
        float(raw_candle[5]),    # vol
        float(raw_candle[6]),    # volCcy - 숫자로 변환됨
        float(raw_candle[7]),    # volCcyQuote - 숫자로 변환됨
        raw_candle[8] == '1',    # confirm - 진짜 True/False
    ]


def fetch_initial_history(symbol, tf):
    url = f"https://www.okx.com/api/v5/market/candles?instId={symbol}&bar={tf}&limit=500"
    try:
        r = requests.get(url, timeout=5)
        raw_data = r.json().get('data', [])
        if not raw_data:
            return []
        formatted_data = [format_candle_data(c) for c in raw_data]
        formatted_data.reverse()
        return formatted_data
    except Exception as e:
        logger.warning(f"{symbol} {tf} 초기 히스토리 로드 실패: {e}")
        return []


def fetch_long_short_ratio(symbol):
    """OKX는 롱숏비율을 웹소켓으로 push 안 함 (REST 전용). 주기적으로 직접 요청.
    아래 엔드포인트는 OKX v5 REST 관례를 따른 것 - 실제 사용 전 공식 문서로 한 번 더
    확인 권장 (검색으로 채널 존재는 확인했지만 정확한 경로까지는 재확인 필요)."""
    url = "https://www.okx.com/api/v5/rubik/stat/contracts/long-short-account-ratio-contract"
    try:
        r = requests.get(url, params={"instId": swap_inst_id(symbol), "period": "5m"}, timeout=5)
        data = r.json().get("data", [])
        if data:
            return float(data[0][1])
    except Exception as e:
        logger.warning(f"{symbol} 롱숏비율 조회 실패: {e}")
    return None


def get_live_candles_with_volume(symbol=None, tf='1h'):
    """저장된 현재가 + 캔들(거래량 포함) 데이터를 읽어서 반환. symbol 생략 시 활성 코인 사용."""
    import pandas as pd
    if symbol is None:
        symbol = get_active_symbol()

    price_file = f"{make_key(symbol, None, 'live_price')}.json"
    if not os.path.exists(price_file):
        logger.warning(f"실시간 현재가 파일({price_file})을 찾을 수 없습니다.")
        return None, 0.0
    with open(price_file, "r") as f:
        current_price = float(json.load(f)["price"])

    candle_file = f"{make_key(symbol, tf, 'candles')}.json"
    if not os.path.exists(candle_file):
        logger.warning(f"실시간 캔들 파일({candle_file})을 찾을 수 없습니다.")
        return None, 0.0
    with open(candle_file, "r") as f:
        raw_candles = json.load(f)

    cols = ['timestamp', 'open', 'high', 'low', 'close', 'volume', 'volCcy', 'volCcyQuote', 'confirm']
    df = pd.DataFrame(raw_candles, columns=cols)
    for col in ['open', 'high', 'low', 'close', 'volume', 'volCcy', 'volCcyQuote']:
        df[col] = pd.to_numeric(df[col], errors='coerce')
    return df, current_price


def _load_all_history(candle_buffers):
    """모든 심볼×타임프레임의 과거 500개를 불러와 반영. 재연결마다 다시 호출해서
    끊긴 구간의 빈 캔들을 메꾼다."""
    for symbol in SYMBOLS:
        for tf in TIMEFRAMES:
            history = fetch_initial_history(symbol, tf)
            if history:
                candle_buffers[(symbol, tf)] = history
                key = make_key(symbol, tf, "candles")
                atomic_save_json(f"{key}.json", history)
                hub.update(key, history)


async def poll_long_short_ratio():
    """롱숏비율은 웹소켓이 없어서 별도 루프로 주기적으로 갱신."""
    while True:
        for symbol in SYMBOLS:
            ratio = fetch_long_short_ratio(symbol)
            if ratio is not None:
                hub.update(make_key(symbol, None, "long_short_ratio"), ratio)
        await asyncio.sleep(LONG_SHORT_POLL_SECONDS)


async def watch_live_market():
    candle_buffers = {}
    logger.info("초기 히스토리 로딩 중...")
    _load_all_history(candle_buffers)

    uri = "wss://ws.okx.com:443/ws/v5/public"

    while True:
        try:
            async with websockets.connect(uri, ping_interval=20, ping_timeout=20) as websocket:
                logger.info("OKX 웹소켓 연결 성공")
                _load_all_history(candle_buffers)  # 재연결마다 히스토리 재로딩

                args = []
                for s in SYMBOLS:
                    args.append({"channel": "tickers", "instId": s})
                    for tf in TIMEFRAMES:
                        args.append({"channel": f"candle{tf}", "instId": s})
                    swap_id = swap_inst_id(s)
                    args.append({"channel": "open-interest", "instId": swap_id})
                    args.append({"channel": "funding-rate", "instId": swap_id})
                await websocket.send(json.dumps({"op": "subscribe", "args": args}))

                async for message in websocket:
                    packet = json.loads(message)

                    if packet.get("event") == "error":
                        logger.error(f"OKX 웹소켓 에러 응답: {packet}")
                        continue
                    if "data" not in packet:
                        continue

                    arg = packet["arg"]
                    channel = arg["channel"]
                    inst_id = arg.get("instId", SYMBOLS[0])
                    symbol = inst_id.replace("-SWAP", "")  # 스왑 채널도 원래 심볼 이름으로 통일
                    raw_data = packet["data"][0]

                    if channel == "tickers":
                        last_price = float(raw_data["last"])
                        key = make_key(symbol, None, "live_price")
                        atomic_save_json(f"{key}.json", {"price": last_price})
                        hub.update(key, last_price)

                    elif channel == "open-interest":
                        key = make_key(symbol, None, "open_interest")
                        hub.update(key, float(raw_data["oi"]))

                    elif channel == "funding-rate":
                        key = make_key(symbol, None, "funding_rate")
                        hub.update(key, float(raw_data["fundingRate"]))

                    elif "candle" in channel:
                        tf_key = channel.replace("candle", "")
                        new_candle = format_candle_data(raw_data)
                        buffer = candle_buffers.setdefault((symbol, tf_key), [])
                        if buffer and buffer[-1][0] == new_candle[0]:
                            buffer[-1] = new_candle
                        else:
                            buffer.append(new_candle)
                            if len(buffer) > 500:
                                buffer.pop(0)
                        key = make_key(symbol, tf_key, "candles")
                        atomic_save_json(f"{key}.json", buffer)
                        hub.update(key, buffer)

        except (websockets.exceptions.ConnectionClosed, OSError, asyncio.TimeoutError) as e:
            logger.warning(f"웹소켓 연결 문제 - 5초 후 재연결 시도: {type(e).__name__}: {e}")
            await asyncio.sleep(5)
        except Exception as e:
            logger.exception(f"예상치 못한 에러 발생 (연결 문제가 아니라 코드 버그일 수 있음): {e}")
            await asyncio.sleep(5)


async def main():
    await asyncio.gather(
        watch_live_market(),
        poll_long_short_ratio(),
    )


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\n👋 수집기가 사용자에 의해 안전하게 종료되었습니다.")
